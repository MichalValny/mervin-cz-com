---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import PostCard from '../components/PostCard.astro';
import { instagram, posts } from '../lib/data';
---

<BaseLayout>
  <div class="container page-layout">
    <section class="section-block">
      <div class="section-header">
        <h2>Nejnovější příspěvky</h2>
      </div>
      <div class="post-grid">
        {posts.slice(0, 8).map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>

    <section class="section-block featured-section">
      <div class="section-header">
        <h2>Co je nového</h2>
      </div>
      <div class="featured-grid">
        {posts.slice(0, 5).map((post, i) => (
          <PostCard post={post} featured={i === 0} />
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-header">
        <h2><a href="/kategorie/zajimavosti/">Zajímavosti</a></h2>
        <a href="/kategorie/zajimavosti/">Všechny →</a>
      </div>
      <div class="post-grid">
        {posts.filter((p) => p.categories.some((c) => c.slug === 'zajimavosti')).slice(0, 2).map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>

    <InstagramFeed feed={instagram} />
  </div>
</BaseLayout>
