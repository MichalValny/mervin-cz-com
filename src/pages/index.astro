---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { posts } from '../lib/data';
---

<BaseLayout>
  <div class="container page-layout">
    <div class="main-content">
      <section class="featured-grid">
        {posts.slice(0, 5).map((post, i) => (
          <PostCard post={post} featured={i === 0} />
        ))}
      </section>

      <section class="section-block">
        <div class="section-header">
          <h2><a href="/kategorie/zajimavosti/">Zajímavosti</a></h2>
          <a href="/kategorie/zajimavosti/">Všechny →</a>
        </div>
        <div class="post-grid">
          {posts.filter((p) => p.categories.some((c) => c.slug === 'zajimavosti')).slice(0, 2).map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>

      <section class="section-block">
        <div class="section-header">
          <h2><a href="/kategorie/kola/">Kola</a></h2>
          <a href="/kategorie/kola/">Všechny →</a>
        </div>
        <div class="post-grid">
          {posts.filter((p) => p.categories.some((c) => c.slug === 'kola')).slice(0, 2).map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>

      <section class="section-block">
        <div class="section-header">
          <h2><a href="/kategorie/motorky/">Motorky</a></h2>
          <a href="/kategorie/motorky/">Všechny →</a>
        </div>
        <div class="post-grid">
          {posts.filter((p) => p.categories.some((c) => c.slug === 'motorky')).slice(0, 4).map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>

      <section class="section-block">
        <div class="section-header">
          <h2>Co je nového</h2>
          <a href="/jak-prispivat/">Jak přispívat →</a>
        </div>
        <div class="post-grid">
          {posts.slice(0, 6).map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    </div>

    <Sidebar />
  </div>
</BaseLayout>
