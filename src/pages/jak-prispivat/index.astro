---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import contributeJson from '../../data/contribute.json';
import { posts } from '../../lib/data';
import { decodeHtml, formatDateShort } from '../../lib/utils';

const contribute = contributeJson;
---

<BaseLayout title="Jak přispívat" description="Jak přidat nový příspěvek na mervin-cz.com">
  <div class="container page-layout">
    <div class="main-content">
      <h1 class="page-title">Jak přispívat</h1>
      <p class="page-description">
        Přehled nejnovějších příspěvků a návod, jak přidat vlastní obsah.
      </p>

      <section class="section-block">
        <div class="section-header">
          <h2>Nejnovější příspěvky</h2>
        </div>
        <div class="contribute-grid">
          {posts.slice(0, 12).map((post) => (
            <a href={post.path} class="contribute-item">
              <strong>{decodeHtml(post.title)}</strong>
              <span>{formatDateShort(post.date)}</span>
            </a>
          ))}
        </div>
      </section>

      {contribute.content && (
        <section class="section-block article-content" set:html={contribute.content} />
      )}
    </div>

    <Sidebar />
  </div>
</BaseLayout>
