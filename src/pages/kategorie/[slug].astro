---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories, getPostsByCategorySlug } from '../../lib/data';

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const categoryPosts = getPostsByCategorySlug(category.slug);
---

<BaseLayout
  title={category.name}
  description={`Příspěvky v rubrice ${category.name} – ${category.count} článků`}
>
  <div class="container page-layout page-layout--wide">
    <header class="page-header">
      <h1 class="page-title">{category.name}</h1>
      <p class="page-description">{category.count} příspěvků</p>
    </header>

    {categoryPosts.length === 0 ? (
      <p class="empty-state">V této rubrice zatím nejsou žádné příspěvky.</p>
    ) : (
      <div class="post-grid">
        {categoryPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
