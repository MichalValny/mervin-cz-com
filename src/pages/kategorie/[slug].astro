---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InstagramFeed from '../../components/InstagramFeed.astro';
import PostCard from '../../components/PostCard.astro';
import { categories, getPostsByCategorySlug, instagram } from '../../lib/data';

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const categoryPosts = getPostsByCategorySlug(category.slug);
---

<BaseLayout
  title={category.name}
  description={`Příspěvky v rubrice ${category.name} – ${category.count} článků`}
>
  <div class="container home-layout">
    <div class="home-content">
      <h1 class="page-title">{category.name}</h1>
      <p class="page-description">{category.count} příspěvků</p>

      {categoryPosts.length === 0 ? (
        <p class="search-empty">V této rubrice zatím nejsou žádné příspěvky.</p>
      ) : (
        <div class="post-grid">
          {categoryPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )}
    </div>

    <aside class="home-aside">
      <InstagramFeed feed={instagram} />
    </aside>
  </div>
</BaseLayout>
