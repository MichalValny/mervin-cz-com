---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getArchives, posts } from '../../lib/data';

export function getStaticPaths() {
  return getArchives().map((archive) => ({
    params: { key: archive.key },
    props: { archive },
  }));
}

const { archive } = Astro.props;
const [year, month] = archive.key.split('-').map(Number);
const archivePosts = posts.filter((p) => p.year === year && p.month === month);
---

<BaseLayout title={archive.label} description={`Archiv ${archive.label}`}>
  <div class="container page-layout">
    <div class="main-content">
      <h1 class="page-title">Archiv: {archive.label}</h1>
      <p class="page-description">{archivePosts.length} příspěvků</p>

      <div class="post-grid">
        {archivePosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </div>

    <Sidebar />
  </div>
</BaseLayout>
