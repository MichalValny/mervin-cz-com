---
import type { InstagramFeed as InstagramFeedData } from '../lib/types';

interface Props {
  feed: InstagramFeedData;
}

const { feed } = Astro.props;
---

{feed.posts.length > 0 && (
  <section class="instagram-widget">
    <h3 class="instagram-widget-title">
      <a href={feed.profileUrl} target="_blank" rel="noopener noreferrer">
        Z našeho Instagramu..
      </a>
    </h3>
    <div class="instagram-grid">
      {feed.posts.map((post) => (
        <a
          class="instagram-item"
          href={post.permalink}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Instagram příspěvek @${feed.username}`}
        >
          <img src={post.imageUrl} alt="" loading="lazy" width="320" height="320" />
        </a>
      ))}
    </div>
  </section>
)}
