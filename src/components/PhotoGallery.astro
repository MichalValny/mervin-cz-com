---
import type { LocalGallery } from '../lib/types';

interface Props {
  gallery: LocalGallery;
  galleryId: string;
}

const { gallery, galleryId } = Astro.props;
const images = gallery.images;
const first = images[0];
---

<div class="gallery-section">
  <div class="photo-gallery" data-gallery-id={galleryId}>
    {gallery.title && (
      <div class="photo-gallery-header">{gallery.title}</div>
    )}

    <div class="photo-gallery-viewer" role="region" aria-label="Prohlížeč fotografií">
      <button type="button" class="photo-gallery-nav photo-gallery-nav--prev" aria-label="Předchozí fotografie">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button type="button" class="photo-gallery-main-wrap" aria-label="Otevřít na celou obrazovku">
        <img
          class="photo-gallery-main"
          src={first.src}
          alt={first.alt ?? ''}
          width="1920"
          height="1080"
          decoding="async"
        />
      </button>

      <button type="button" class="photo-gallery-nav photo-gallery-nav--next" aria-label="Další fotografie">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <span class="photo-gallery-counter" aria-live="polite">1 / {images.length}</span>
    </div>

    <div class="photo-gallery-filmstrip-wrap">
      <div class="photo-gallery-filmstrip" role="tablist" aria-label="Náhledy fotografií">
        {images.map((image, index) => (
          <button
            type="button"
            class:list={['photo-gallery-thumb', { 'is-active': index === 0 }]}
            data-index={index}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={`Fotografie ${index + 1} z ${images.length}`}
          >
            <img src={image.thumb} alt="" loading="lazy" width="120" height="120" />
          </button>
        ))}
      </div>
    </div>

    <script type="application/json" class="photo-gallery-data" set:html={JSON.stringify(images)} />
  </div>
</div>

<div class="photo-gallery-lightbox" hidden aria-hidden="true">
  <button type="button" class="photo-gallery-lightbox-close" aria-label="Zavřít">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <button type="button" class="photo-gallery-lightbox-nav photo-gallery-lightbox-nav--prev" aria-label="Předchozí fotografie">
    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
  <div class="photo-gallery-lightbox-stage">
    <div class="photo-gallery-lightbox-viewport">
      <img class="photo-gallery-lightbox-img" src="" alt="" />
    </div>
  </div>
  <button type="button" class="photo-gallery-lightbox-nav photo-gallery-lightbox-nav--next" aria-label="Další fotografie">
    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>
  <span class="photo-gallery-lightbox-counter"></span>
</div>

<script>
  function initPhotoGallery(root: HTMLElement) {
    const dataEl = root.querySelector('.photo-gallery-data');
    if (!dataEl?.textContent) return;

    const images: { src: string; thumb: string; alt?: string }[] = JSON.parse(dataEl.textContent);
    let index = 0;

    const mainImg = root.querySelector<HTMLImageElement>('.photo-gallery-main')!;
    const counter = root.querySelector<HTMLElement>('.photo-gallery-counter')!;
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('.photo-gallery-thumb')];
    const prevBtn = root.querySelector<HTMLButtonElement>('.photo-gallery-nav--prev')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('.photo-gallery-nav--next')!;
    const mainWrap = root.querySelector<HTMLButtonElement>('.photo-gallery-main-wrap')!;

    const lightbox = document.querySelector<HTMLElement>('.photo-gallery-lightbox')!;
    const lightboxStage = lightbox.querySelector<HTMLElement>('.photo-gallery-lightbox-stage')!;
    const lightboxViewport = lightbox.querySelector<HTMLElement>('.photo-gallery-lightbox-viewport')!;
    const lightboxImg = lightbox.querySelector<HTMLImageElement>('.photo-gallery-lightbox-img')!;
    const lightboxCounter = lightbox.querySelector<HTMLElement>('.photo-gallery-lightbox-counter')!;
    const lightboxClose = lightbox.querySelector<HTMLButtonElement>('.photo-gallery-lightbox-close')!;
    const lightboxPrev = lightbox.querySelector<HTMLButtonElement>('.photo-gallery-lightbox-nav--prev')!;
    const lightboxNext = lightbox.querySelector<HTMLButtonElement>('.photo-gallery-lightbox-nav--next')!;

    function resetImageView(
      target: HTMLElement | null,
      img: HTMLImageElement | null,
      animate = true,
    ) {
      if (target) {
        target.dataset.zoomScale = '1';
        target.classList.remove('is-dragging', 'is-zoomed');
        target.style.transform = '';
        target.style.transition = animate ? '' : 'none';
      }
      if (img) {
        img.dataset.zoomScale = '1';
        img.classList.remove('is-dragging', 'is-zoomed');
      }
    }

    function show(i: number) {
      index = (i + images.length) % images.length;
      const image = images[index];
      mainImg.src = image.src;
      mainImg.alt = image.alt ?? '';
      resetImageView(mainImg, mainImg);
      counter.textContent = `${index + 1} / ${images.length}`;

      thumbs.forEach((thumb, ti) => {
        const active = ti === index;
        thumb.classList.toggle('is-active', active);
        thumb.setAttribute('aria-selected', active ? 'true' : 'false');
        if (active) {
          thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });

      if (!lightbox.hidden) {
        lightboxImg.src = image.src;
        lightboxImg.alt = image.alt ?? '';
        resetImageView(lightboxViewport, lightboxImg);
        lightboxCounter.textContent = `${index + 1} / ${images.length}`;
      }
    }

    function closeLightbox() {
      lightbox.hidden = true;
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('photo-gallery-open');
      resetImageView(lightboxViewport, lightboxImg);
    }

    function bindTouchGallery(
      element: HTMLElement,
      getTransformTarget: () => HTMLElement | null,
      getFocalTarget: () => HTMLElement | null,
      onSwipeLeft: () => void,
      onSwipeRight: () => void,
      onGestureStart?: () => void,
    ) {
      const MIN_SCALE = 1;
      const MAX_SCALE = 4;
      const PINCH_SENSITIVITY = 0.28;

      let scale = 1;
      let panX = 0;
      let panY = 0;

      let startX = 0;
      let startY = 0;
      let startTime = 0;
      let panStartX = 0;
      let panStartY = 0;
      let tracking = false;
      let locked: 'x' | 'y' | null = null;

      let pinching = false;
      let pinchStartDist = 0;
      let pinchStartScale = 1;
      let pinchStartPanX = 0;
      let pinchStartPanY = 0;
      let pinchFocalRelX = 0;
      let pinchFocalRelY = 0;

      const getDistance = (t1: Touch, t2: Touch) =>
        Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);

      const getFocalOffset = (clientX: number, clientY: number) => {
        const focalTarget = getFocalTarget() ?? getTransformTarget();
        if (!focalTarget) {
          const rect = element.getBoundingClientRect();
          return {
            x: clientX - (rect.left + rect.width / 2),
            y: clientY - (rect.top + rect.height / 2),
          };
        }

        const rect = focalTarget.getBoundingClientRect();
        return {
          x: clientX - (rect.left + rect.width / 2),
          y: clientY - (rect.top + rect.height / 2),
        };
      };

      const beginPinch = (t0: Touch, t1: Touch) => {
        pinching = true;
        tracking = false;
        locked = null;
        onGestureStart?.();

        pinchStartDist = Math.max(getDistance(t0, t1), 24);
        pinchStartScale = scale;
        pinchStartPanX = panX;
        pinchStartPanY = panY;

        const centerX = (t0.clientX + t1.clientX) / 2;
        const centerY = (t0.clientY + t1.clientY) / 2;
        const focal = getFocalOffset(centerX, centerY);
        pinchFocalRelX = focal.x;
        pinchFocalRelY = focal.y;

        applyTransform(false);
      };

      const applyTransform = (animate: boolean) => {
        const target = getTransformTarget();
        if (!target) return;

        target.classList.toggle('is-dragging', !animate);
        target.style.transition = animate ? '' : 'none';

        if (scale <= 1.01 && Math.abs(panX) < 1 && Math.abs(panY) < 1) {
          scale = 1;
          panX = 0;
          panY = 0;
          target.dataset.zoomScale = '1';
          target.classList.remove('is-zoomed');
          target.style.transform = '';
          return;
        }

        target.dataset.zoomScale = scale.toFixed(2);
        target.classList.add('is-zoomed');
        target.style.transform = `translate3d(${panX}px, ${panY}px, 0) scale(${scale})`;
      };

      const resetView = (animate = true) => {
        scale = 1;
        panX = 0;
        panY = 0;
        pinching = false;
        tracking = false;
        locked = null;
        resetImageView(getTransformTarget(), getFocalTarget() as HTMLImageElement | null, animate);
      };

      element.addEventListener('touchstart', (event) => {
        if (event.touches.length === 2) {
          beginPinch(event.touches[0], event.touches[1]);
          return;
        }

        if (event.touches.length !== 1 || pinching) return;

        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
        startTime = performance.now();
        panStartX = panX;
        panStartY = panY;
        tracking = true;
        locked = null;
        applyTransform(false);
      }, { passive: true });

      element.addEventListener('touchmove', (event) => {
        if (event.touches.length === 2) {
          if (!pinching) {
            beginPinch(event.touches[0], event.touches[1]);
          }

          event.preventDefault();
          onGestureStart?.();

          const dist = getDistance(event.touches[0], event.touches[1]);
          const pinchRatio = dist / pinchStartDist;
          const dampedRatio = 1 + (pinchRatio - 1) * PINCH_SENSITIVITY;
          const nextScale = Math.min(
            MAX_SCALE,
            Math.max(MIN_SCALE, pinchStartScale * dampedRatio),
          );
          const scaleRatio = nextScale / pinchStartScale;

          scale = nextScale;
          panX = pinchFocalRelX * (1 - scaleRatio) + pinchStartPanX * scaleRatio;
          panY = pinchFocalRelY * (1 - scaleRatio) + pinchStartPanY * scaleRatio;
          applyTransform(false);
          return;
        }

        if (!tracking || event.touches.length !== 1 || pinching) return;

        const dx = event.touches[0].clientX - startX;
        const dy = event.touches[0].clientY - startY;

        if (scale > 1) {
          event.preventDefault();
          panX = panStartX + dx;
          panY = panStartY + dy;
          applyTransform(false);
          return;
        }

        if (!locked) {
          if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
          locked = Math.abs(dx) >= Math.abs(dy) ? 'x' : 'y';
        }

        if (locked !== 'x') return;

        const target = getTransformTarget();
        if (!target) return;

        target.classList.add('is-dragging');
        target.style.transform = `translate3d(${dx}px, 0, 0)`;

        if (Math.abs(dx) > 8) {
          event.preventDefault();
        }
      }, { passive: false });

      element.addEventListener('touchcancel', () => {
        if (pinching) {
          pinching = false;
          if (scale < 1.05) resetView(false);
          else applyTransform(false);
          return;
        }

        tracking = false;
        locked = null;
        applyTransform(false);
      }, { passive: true });

      element.addEventListener('touchend', (event) => {
        if (pinching && event.touches.length < 2) {
          pinching = false;
          if (scale < 1.05) {
            resetView(false);
          } else {
            applyTransform(false);
          }

          if (event.touches.length === 1 && scale > 1) {
            startX = event.touches[0].clientX;
            startY = event.touches[0].clientY;
            panStartX = panX;
            panStartY = panY;
            tracking = true;
            locked = null;
          }
        }

        if (!tracking || event.touches.length > 0) return;
        tracking = false;

        if (scale > 1) {
          locked = null;
          applyTransform(true);
          onGestureStart?.();
          return;
        }

        const touch = event.changedTouches[0];
        const dx = touch.clientX - startX;
        const dy = touch.clientY - startY;
        const elapsed = Math.max(performance.now() - startTime, 1);
        const velocity = Math.abs(dx) / elapsed;
        const wasHorizontal = locked === 'x';
        locked = null;

        applyTransform(true);

        if (!wasHorizontal) return;

        const minDistance = 20;
        const minFlickDistance = 10;
        const minVelocity = 0.25;
        const shouldSwipe =
          Math.abs(dx) >= minDistance ||
          (velocity >= minVelocity && Math.abs(dx) >= minFlickDistance);

        if (!shouldSwipe) return;
        if (Math.abs(dy) > Math.abs(dx) * 1.25) return;

        onGestureStart?.();
        if (dx < 0) onSwipeLeft();
        else onSwipeRight();
      }, { passive: true });

      return { resetView };
    }

    let suppressLightboxOpen = false;
    const viewer = root.querySelector<HTMLElement>('.photo-gallery-viewer')!;
    const markGesture = () => { suppressLightboxOpen = true; };

    bindTouchGallery(
      viewer,
      () => mainImg,
      () => mainImg,
      () => show(index + 1),
      () => show(index - 1),
      markGesture,
    );

    bindTouchGallery(
      lightboxStage,
      () => lightboxViewport,
      () => lightboxImg,
      () => show(index + 1),
      () => show(index - 1),
      markGesture,
    );

    function openLightbox() {
      if (Number(mainImg.dataset.zoomScale ?? '1') > 1) return;
      lightbox.hidden = false;
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.classList.add('photo-gallery-open');
      lightboxImg.src = images[index].src;
      lightboxImg.alt = images[index].alt ?? '';
      resetImageView(lightboxViewport, lightboxImg);
      lightboxCounter.textContent = `${index + 1} / ${images.length}`;
    }

    prevBtn.addEventListener('click', () => show(index - 1));
    nextBtn.addEventListener('click', () => show(index + 1));
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => show(Number(thumb.dataset.index)));
    });
    mainWrap.addEventListener('click', () => {
      if (suppressLightboxOpen) {
        suppressLightboxOpen = false;
        return;
      }
      openLightbox();
    });
    lightboxClose.addEventListener('click', closeLightbox);
    lightboxPrev.addEventListener('click', () => show(index - 1));
    lightboxNext.addEventListener('click', () => show(index + 1));

    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    document.addEventListener('keydown', (event) => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
  }

  document.querySelectorAll<HTMLElement>('.photo-gallery').forEach(initPhotoGallery);
</script>
