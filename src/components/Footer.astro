---
import { site, categories } from '../lib/data';

const topCategories = categories.filter((c) => c.parent === 0).slice(0, 6);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <a href="/">
        <img src={site.logo} alt={site.siteName} height="36" style="opacity: 0.9" />
      </a>
      <p style="margin: 0.75rem 0 0; font-size: 0.9rem">
        Mervinovy stránky od roku 1996
      </p>
    </div>
    <nav class="footer-categories" aria-label="Rubriky">
      {topCategories.map((cat) => (
        <a href={`/kategorie/${cat.slug}/`}>{cat.name}</a>
      ))}
      <a href="/jak-prispivat/">Jak přispívat</a>
    </nav>
  </div>
</footer>
