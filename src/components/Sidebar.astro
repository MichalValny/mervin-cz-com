---
import { categories } from '../lib/data';

const topCategories = categories.slice(0, 12);
---

<aside class="sidebar">
  <div class="sidebar-widget">
    <h3>Rubriky</h3>
    <ul class="sidebar-list">
      {topCategories.map((cat) => (
        <li>
          <a href={`/kategorie/${cat.slug}/`}>
            {cat.name}
            <span class="count"> ({cat.count})</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>
