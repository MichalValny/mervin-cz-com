---
import type { Post } from '../lib/types';
import { decodeHtml, formatDate, getExcerpt, getPostImage } from '../lib/utils';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = getPostImage(post);
const category = post.categories[0];
const excerpt = getExcerpt(post, 120);
---

<article class="post-card">
  <a href={post.path} class="post-card-image">
    {image ? (
      <img src={image} alt="" loading="lazy" />
    ) : (
      <span class="post-card-image-placeholder" aria-hidden="true"></span>
    )}
    {category && (
      <span class="post-card-category-overlay">{category.name}</span>
    )}
  </a>
  <div class="post-card-body">
    <h3 class="post-card-title">
      <a href={post.path}>{decodeHtml(post.title)}</a>
    </h3>
    <div class="post-card-meta">{formatDate(post.date)}</div>
    {excerpt && <p class="post-card-excerpt">{excerpt}</p>}
  </div>
</article>
