---
import type { Post } from '../lib/types';
import { decodeHtml, formatDateShort, getPostImage } from '../lib/utils';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const image = getPostImage(post);
const category = post.categories[0];
---

<article class:list={['post-card', { 'post-card-featured': featured }]}>
  {image && (
    <a href={post.path} class="post-card-image">
      <img src={image} alt="" loading="lazy" />
    </a>
  )}
  <div class="post-card-body">
    {category && (
      <span class="post-card-category">{category.name}</span>
    )}
    <h3 class="post-card-title">
      <a href={post.path}>{decodeHtml(post.title)}</a>
    </h3>
    <div class="post-card-meta">{formatDateShort(post.date)}</div>
  </div>
</article>
