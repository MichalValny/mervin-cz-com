# Bootstrap (GitHub Secrets AWS_BOOTSTRAP_* — workflow Bootstrap AWS only)
AWS_BOOTSTRAP_ACCESS_KEY_ID=
AWS_BOOTSTRAP_SECRET_ACCESS_KEY=

# Deploy (GitHub Secrets AWS_DEPLOY_* — workflow Deploy to AWS)
AWS_DEPLOY_ACCESS_KEY_ID=
AWS_DEPLOY_SECRET_ACCESS_KEY=

AWS_REGION=us-east-1
S3_BUCKET=web-mervin-cz-com

# Upload API
UPLOAD_JWT_SECRET=
UPLOAD_PASSWORD_MICHAL=
UPLOAD_PASSWORD_HORAK=
UPLOAD_GITHUB_TOKEN=
UPLOAD_S3_BUCKET=web-mervin-cz-com

# Optional custom domain (bootstrap requests ACM cert when set)
# CLOUDFRONT_ALIASES=www.mervin-cz.com,mervin-cz.com
# ACM_CERTIFICATE_ARN=
